#!/usr/bin/env python3
import sys
import os

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
if sys.argv[1:] == ["--version"]:
    from core import __version__
    print(__version__)
    sys.exit(0)
from core.cli import main

if __name__ == '__main__':
    sys.exit(main())
